{
  "name": "food-business-manager",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "dev:electron": "wait-on http://127.0.0.1:5174 && node electron/run-electron.js http://127.0.0.1:5174",
    "build": "vite build",
    "electron": "node electron/run-electron.js",
    "package": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win"
  },
  "build": {
    "appId": "com.foodbusiness.manager",
    "productName": "Food Business Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "src/assets/app-icon.ico"
    },
    "nsis": {
      "installerIcon": "src/assets/app-icon.ico",
      "uninstallerIcon": "src/assets/app-icon.ico"
    }
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.5"
  },
  "allowScripts": {
    "core-js@3.49.0": true,
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
